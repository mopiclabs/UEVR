      ],
      "threshold": 0.8
    },
    "new_round": {
      "image": "new_round.png",
      "region": [
        490,
        320,
        300,
        30
      ],
      "threshold": 0.8
    },
    "cancel_hover": {
      "image": "cancel_hover.png",
      "region": [
        650,
        410,
        250,
        26
      ],
      "threshold": 0.8,
      "mode": "highlight"
    },
    "loading": {
      "image": "loading.png",
      "region": [
        566,
        666,
        148,
        30
      ],
      "threshold": 0.8
    },
    "pause_menu": {
      "image": "pause_menu.png",
      "region": [
        38,
