        110,
        28
      ],
      "threshold": 0.8
    },
    "exit_panel": {
      "image": "exit_panel.png",
      "region": [
        222,
        178,
        104,
        26
      ],
      "threshold": 0.8
    },
    "quit_confirm": {
      "image": "quit_confirm.png",
      "region": [
        516,
        320,
        248,
        30
      ],
      "threshold": 0.8
    },
    "quit_confirm_unsaved": {
      "image": "quit_confirm_unsaved.png",
      "region": [
        444,
        310,
        392,
        28
      ],
      "threshold": 0.8
    },
    "loading_band": {
      "image": "loading_band.png",
      "region": [
        420,
