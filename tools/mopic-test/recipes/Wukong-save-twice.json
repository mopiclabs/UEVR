      ],
      "threshold": 0.8
    }
  },
  "steps": [
    {
      "phase": "boot"
    },
    {
      "wait_for": [
        "title",
        "main_menu"
      ],
      "timeout": 300
    },
    {
      "key": "enter",
      "if": "title"
    },
    {
      "note": "an Enter while the title is still fading in is dropped (5 of 15 ladder rungs on 2026-10-04 stayed on the title): click an empty corner until the menu shows; a click there does nothing on the menu, an Enter could pick 계속하기"
    },
    {
      "wait_for": "main_menu",
      "timeout": 60,
      "click": [
        1220,
        660
      ],
      "every": 6
    },
    {
      "phase": "load"
    },
    {
      "note": "게임 로딩 (Load Game), hovered first: the highlight shows the click will hit it"
    },
    {
      "move": [
        110,
        379
      ]
    },
    {
      "wait_for": "load_hover",
      "timeout": 15
    },
    {
      "click": [
        110,
        379
      ]
    },
    {
      "wait_for": "load_list",
      "timeout": 30
    },
    {
      "wait_for": "five_saves",
      "timeout": 10
    },
    {
      "note": "the installed save is the oldest: scroll the list to its end with the mouse over it, then the last entry sits under the mouse"
    },
    {
      "move": [
        430,
        480
      ]
    },
    {
      "key": "wheel:-10"
    },
    {
      "wait": 1.5
    },
    {
      "move": [
        430,
        480
      ]
    },
    {
      "wait_for": "last_save_hover",
      "timeout": 10
    },
    {
      "key": "e"
    },
    {
      "wait_for": "load_confirm",
      "timeout": 15
    },
    {
      "move": [
        503,
        423
      ]
    },
    {
      "click": [
        503,
        423
      ]
    },
    {
      "note": "a cleared save asks to start a new round (NG+): 취소 loads it as it is"
    },
    {
      "wait_for": [
        "new_round",
        "loading",
        "loading_band"
      ],
      "timeout": 30
    },
    {
      "move": [
        777,
        423
      ],
      "if": "new_round"
    },
    {
      "wait_for": "cancel_hover",
      "timeout": 10,
      "if": "new_round",
      "move": [
        777,
        423
      ],
      "every": 2
    },
    {
      "click": [
        777,
        423
      ],
      "if": "new_round"
    },
    {
      "wait_for": [
        "loading",
        "loading_band"
      ],
      "timeout": 60
    },
    {
      "note": "the loading screen (20-60 s) animates its bottom ornament (the icon and the swirls fade out, at times all of it for 5 s and more), so the band behind the tip title (loading_band, the same on every tip) decides; play starts when neither has shown for 5 s"
    },
    {
      "wait_gone": [
        "loading",
        "loading_band"
      ],
      "timeout": 300,
      "for": 5
    },
    {
      "wait": "${load_wait_s}"
    },
    {
      "phase": "play"
    },
    {
      "shot": "spawn"
    },
    {
      "play": "${play_s}",
      "keys": "w a s d w s a d shift+w shift+s",
      "every": 0.25,
      "hold": 900,
      "measure": "first"
    },
    {
      "play": 30,
      "keys": "look:900,0 look:-900,0 look:0,150 look:0,-150 look:1800,0 look:-450,0",
      "every": 0.4,
      "hold": 700,
      "measure": "first"
    },
    {
      "play": "${play_s}",
      "keys": "lmb lmb lmb lmb rmb space space ctrl v",
      "every": 0.45,
      "hold": 120,
      "measure": "first"
    },
    {
      "play": "${play_s}",
      "keys": "shift+w shift+a shift+d shift+s look:700,0 look:-700,0 w s",
      "every": 0.3,
      "hold": 800,
      "measure": "first"
    },
    {
      "play": 20,
      "keys": "1 2 lmb space",
      "every": 1.2,
      "hold": 100,
      "measure": "first"
    },
    {
      "play": "${play_s}",
      "keys": "w a s d look:600,0 look:-600,0 lmb lmb space rmb shift+w ctrl",
      "every": 0.35,
      "hold": 450,
      "measure": "first"
    },
    {
      "note": "the same play keys again in the same session and area: pipeline states the first pass created are cached now"
    },
    {
      "phase": "again"
    },
    {
      "play": "${play_s}",
      "keys": "w a s d w s a d shift+w shift+s",
      "every": 0.25,
      "hold": 900,
      "measure": "again"
    },
    {
      "play": 30,
      "keys": "look:900,0 look:-900,0 look:0,150 look:0,-150 look:1800,0 look:-450,0",
      "every": 0.4,
      "hold": 700,
      "measure": "again"
    },
    {
      "play": "${play_s}",
      "keys": "lmb lmb lmb lmb rmb space space ctrl v",
      "every": 0.45,
      "hold": 120,
      "measure": "again"
    },
    {
      "play": "${play_s}",
      "keys": "shift+w shift+a shift+d shift+s look:700,0 look:-700,0 w s",
      "every": 0.3,
      "hold": 800,
      "measure": "again"
    },
    {
      "play": 20,
      "keys": "1 2 lmb space",
      "every": 1.2,
      "hold": 100,
      "measure": "again"
    },
    {
      "play": "${play_s}",
      "keys": "w a s d look:600,0 look:-600,0 lmb lmb space rmb shift+w ctrl",
      "every": 0.35,
      "hold": 450,
      "measure": "again"
    },
    {
      "key": "esc"
    },
    {
      "wait_for": "pause_menu",
      "timeout": 60,
      "press": "esc",
      "every": 8
    },
    {
      "phase": "leave"
    },
    {
      "seek": "settings_tab",
      "press": "d",
      "max": 7,
      "gap": 1.5
    },
    {
      "move": [
        196,
        533
      ]
    },
    {
      "click": [
        196,
        533
      ]
    },
    {
      "wait_for": "exit_panel",
      "timeout": 15
    },
    {
      "click": [
        272,
        190
      ]
    },
    {
      "note": "the question gets a second line (unsaved progress is lost) when the game has not saved lately"
    },
    {
      "wait_for": [
        "quit_confirm",
        "quit_confirm_unsaved"
      ],
      "timeout": 15
    },
    {
      "wait": 1
    },
    {
      "phase": "exit"
    },
    {
      "click": [
        503,
        423
      ]
    },
    {
      "expect_exit": 90
    }
  ],
  "images": "Wukong-save"
}