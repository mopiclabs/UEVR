{
  "game": "Hogwarts Legacy",
  "process": "HogwartsLegacy",
  "source": "mopic",
  "max_width": 1280,
  "images": "Hogwarts",
  "notes": "Sets the game's FRAME GENERATION option through its own menu, then quits (the game keeps a second settings copy in SaveGames\\<acct>\\SavedUserOptions.sav that overrides GameUserSettings.ini, so -GameIni can't change it). Route: title > the ARAM HAN card > in game > Esc (field guide) > 설정 > 디스플레이 옵션 (2nd side icon) > FRAME GENERATION row arrow opens a dropdown (꺼짐, Intel XeSS Frame Generation x2; DLSS-G is not offered while HAGS is off) > pick > '재시작이 필요합니다' notice, Space (수락) > 게임 저장 tab > 게임 종료 > Space. The game writes both settings copies at quit. Default vars turn it off; back to x2: --var target=fg_x2 from=fg_off pick=[528,600] dropdown=fg_dropdown_off. The pick click is guarded by the dropdown checkpoint: the same spot hits the RAY RECONSTRUCTION row when the dropdown is closed. Nothing is played and nothing is saved besides the settings.",
  "vars": {"target": "fg_off", "from": "fg_x2", "pick": [528, 573], "dropdown": "fg_dropdown"},
  "checkpoints": {
    "title": {"image": "title.png", "region": [490, 590, 300, 34], "threshold": 0.8},
    "char_select": {"image": "char_select.png", "region": [62, 502, 356, 36], "threshold": 0.8},
    "slot_aram": {"image": "slot_aram.png", "region": [64, 136, 260, 32], "threshold": 0.8},
    "loading": {"image": "loading.png", "region": [36, 588, 96, 26], "threshold": 0.8},
    "in_game": {"image": "in_game.png", "region": [994, 562, 262, 66], "threshold": 0.8},
    "field_guide": {"image": "field_guide.png", "region": [1040, 686, 214, 22], "threshold": 0.8},
    "settings_menu": {"image": "settings_menu.png", "region": [166, 350, 454, 36], "threshold": 0.8},
    "quit_confirm": {"image": "quit_confirm.png", "region": [550, 300, 180, 28], "threshold": 0.8},
    "display_menu": {"image": "display_menu.png", "region": [214, 96, 130, 26], "threshold": 0.8},
    "fg_x2": {"image": "fg_x2.png", "region": [545, 530, 290, 26], "threshold": 0.8},
    "fg_off": {"image": "fg_off.png", "region": [545, 530, 290, 26], "threshold": 0.8},
    "fg_dropdown": {"image": "fg_dropdown.png", "region": [205, 562, 650, 22], "threshold": 0.8},
    "restart_notice": {"image": "restart_notice.png", "region": [470, 310, 340, 26], "threshold": 0.8},
    "fg_dropdown_off": {"image": "fg_dropdown_off.png", "region": [205, 562, 650, 48], "threshold": 0.8}
  },
  "steps": [
    {"phase": "boot"},
    {"wait_for": ["title", "char_select"], "timeout": 300},
    {"key": "enter", "if": "title"},
    {"wait_for": "char_select", "timeout": 60},
    {"phase": "enter"},
    {"wait_for": "slot_aram", "timeout": 10},
    {"click": [240, 165]},
    {"wait_for": "loading", "timeout": 60},
    {"wait_for": "in_game", "timeout": 240},
    {"wait": 3},
    {"key": "esc"},
    {"wait_for": "field_guide", "timeout": 30, "press": "esc", "every": 6},
    {"phase": "leave"},
    {"click": [842, 545]},
    {"wait_for": "settings_menu", "timeout": 15},
    {"note": "디스플레이 옵션"},
    {"click": [106, 180]},
    {"wait_for": "display_menu", "timeout": 10},
    {"wait_for": ["fg_off", "fg_x2"], "timeout": 10},
    {"shot": "fg-before"},
    {"click": [840, 543], "if": "${from}"},
    {"wait": 1.5},
    {"click": "${pick}", "if": "${dropdown}"},
    {"wait_for": ["restart_notice", "${target}"], "timeout": 10},
    {"key": "space", "if": "restart_notice"},
    {"wait_for": "${target}", "timeout": 10},
    {"shot": "fg-after"},
    {"note": "back to 게임 저장, then 게임 종료"},
    {"click": [106, 120]},
    {"wait_for": "settings_menu", "timeout": 15},
    {"click": [392, 367]},
    {"wait_for": "quit_confirm", "timeout": 15},
    {"phase": "exit"},
    {"key": "space"},
    {"expect_exit": 150}
  ]
}
