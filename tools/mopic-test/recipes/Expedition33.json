{
  "game": "Clair Obscur: Expedition 33",
  "process": "SandFall-Win64-Shipping",
  "source": "mopic",
  "max_width": 1280,
  "notes": "Keyboard: Enter confirm, Esc back/pause, W/A/S/D move, F load (in the load list) / interact (in game). NEVER press R in the load list (deletes a save). Route: warning > title > Continue > newest save (F) > camp > walk > pause > 종료 (quit) > 확인. The first key press on the main menu shows the cursor on Continue.",
  "checkpoints": {
    "warning": {"image": "warning.png", "region": [400, 130, 480, 55], "threshold": 0.8},
    "title": {"image": "title.png", "region": [470, 562, 340, 44], "threshold": 0.8},
    "main_menu": {"image": "main_menu.png", "region": [616, 652, 58, 32], "threshold": 0.8},
    "continue_selected": {"image": "continue_selected.png", "region": [600, 532, 84, 24], "threshold": 0.8},
    "load_game": {"image": "load_game.png", "region": [84, 44, 146, 34], "threshold": 0.8},
    "load_confirm": {"image": "load_confirm.png", "region": [518, 320, 246, 36], "threshold": 0.8},
    "pause_menu": {"image": "pause_menu.png", "region": [110, 96, 190, 132], "threshold": 0.8},
    "pause_quit_selected": {"image": "pause_quit_selected.png", "region": [48, 344, 272, 54], "threshold": 0.8},
    "quit_confirm": {"image": "quit_confirm.png", "region": [488, 320, 306, 36], "threshold": 0.8},
    "dialog_ok_selected": {"image": "dialog_ok_selected.png", "region": [484, 360, 162, 42], "threshold": 0.8}
  },
  "steps": [
    {"phase": "boot"},
    {"note": "photosensitivity warning, then the title ('press any button')"},
    {"wait_for": ["warning", "title", "main_menu"], "timeout": 180},
    {"key": "enter", "if": "warning"},
    {"wait_for": ["title", "main_menu"], "timeout": 90},
    {"key": "enter", "if": "title"},
    {"wait_for": "main_menu", "timeout": 30},
    {"phase": "enter"},
    {"note": "the first key press shows the cursor (on Continue)"},
    {"key": "down"},
    {"seek": "continue_selected", "press": "up", "max": 4},
    {"key": "enter"},
    {"wait_for": "load_game", "timeout": 30},
    {"note": "F loads the newest save (the first slot); R would delete it"},
    {"key": "f"},
    {"wait_for": "load_confirm", "timeout": 15},
    {"seek": "dialog_ok_selected", "press": "left", "max": 2},
    {"key": "enter"},
    {"wait": 25},
    {"phase": "play"},
    {"note": "walk around the camp (movement keys only)"},
    {"play": 45, "keys": "w a s d w w", "every": 0.7, "hold": 500},
    {"key": "esc"},
    {"wait_for": "pause_menu", "timeout": 60, "press": "esc", "every": 5},
    {"phase": "leave"},
    {"seek": "pause_quit_selected", "press": "down", "max": 8},
    {"key": "enter"},
    {"wait_for": "quit_confirm", "timeout": 15},
    {"seek": "dialog_ok_selected", "press": "left", "max": 2},
    {"phase": "exit"},
    {"key": "enter"},
    {"expect_exit": 60}
  ]
}
