{
  "draft": true,
  "game": "TEKKEN 8 Demo (Super Ghost Battle)",
  "process": "Polaris-Win64-Shipping",
  "source": "mopic",
  "max_width": 1280,
  "images": "Tekken8Demo",
  "notes": "DRAFT SKELETON, never run. Super Ghost Battle is locked until Arcade Quest Chapter 1 is cleared (ladder rung aq-ch1 first, or pin that rung's save-after\\global1.sav). It is not on the home tab (STORY, ARCADE QUEST, PLAYER VS PLAYER, PLAYER VS CPU, GALLERY), so it is expected on the OFFLINE tab: P moves one tab right (home > STORY > OFFLINE). In the demo you fight your own ghost (ghost_*.sav, 4 files on mopic_demo1). Fighters vary, so the KAZUYA-plate in_match does not apply: the match needs a fighter-independent HUD checkpoint. Play 2 matches, then back to the main menu and quit.",
  "window_fit": [64, 0, 1152, 720],
  "height": 720,
  "save_slot": {"dir": "{localappdata}\\TEKKEN 8 Demo\\Saved\\SaveGames\\{sid64}", "file": "global1.sav"},
  "vars": {"offline_tabs": 2, "match_timeout": 600},
  "todo": ["Record the OFFLINE tab (title / its item list) and the SUPER GHOST BATTLE item highlight; check offline_tabs (P presses from the home tab).", "What follows the item: ghost select, character select (which cursor rules), difficulty, stage select.", "match_hud: a fighter-independent HUD element (timer frame); sgb_post_match: the menu after a ghost match and where 'next match' / 'main menu' sit.", "If Super Ghost Battle is still locked, record the lock notice so the run ends with a clear MENU_FAIL instead of a timeout."],
  "todo_checkpoints": {"offline_tab": {"region_guess": [112, 100, 600, 40], "what": "OFFLINE tab underlined"}, "sgb_selected": {"region_guess": null, "what": "SUPER GHOST BATTLE item highlighted (highlight mode)"}, "sgb_locked": {"region_guess": null, "what": "lock notice"}, "sgb_select": {"region_guess": null, "what": "ghost / character select screen"}, "match_hud": {"region_guess": [588, 64, 104, 56], "what": "match timer frame"}, "sgb_post_match": {"region_guess": null, "what": "post-match menu"}, "sgb_post_match_main_menu": {"region_guess": null, "what": "'main menu' item highlighted"}},
  "checkpoints": {
    "notice": {"image": "notice.png", "region": [429, 293, 422, 100], "threshold": 0.8},
    "title": {"image": "title.png", "region": [834, 336, 400, 66], "threshold": 0.8},
    "main_menu": {"image": "main_menu.png", "region": [54, 33, 136, 38], "threshold": 0.8},
    "story_selected": {"image": "story_selected.png", "region": [87, 140, 238, 31], "threshold": 0.8, "mode": "highlight"},
    "options": {"image": "options.png", "region": [53, 33, 100, 38], "threshold": 0.8},
    "options_selected": {"image": "options_selected.png", "region": [72, 541, 40, 40], "threshold": 0.8, "mode": "highlight"},
    "quit_selected": {"image": "quit_selected.png", "region": [304, 478, 671, 31], "threshold": 0.8, "mode": "highlight"},
    "quit_confirm": {"image": "quit_confirm.png", "region": [529, 304, 222, 89], "threshold": 0.8},
    "quit_yes": {"image": "quit_yes.png", "region": [364, 364, 551, 60], "threshold": 0.8, "mode": "highlight"},
    "stage_select": {"image": "stage_select.png", "region": [60, 56, 238, 73], "threshold": 0.8},
    "offline_tab": {"image": "offline_tab.png", "region": [262, 80, 94, 27], "threshold": 0.8}
  },
  "steps": [
    {"phase": "boot"},
    {"wait_for": "notice", "timeout": 150},
    {"key": "enter"},
    {"wait_for": ["title", "main_menu"], "timeout": 240, "press": "enter", "every": 5},
    {"wait": 1, "if": "title"},
    {"key": "enter", "if": "title"},
    {"wait_for": "main_menu", "timeout": 60, "press": "enter", "every": 5},
    {"phase": "enter"},
    {"seek": "story_selected", "press": "up", "max": 6},
    {"note": "P = next tab (TODO: confirm OFFLINE is 2 tabs right of home)"},
    {"key": "p", "times": "${offline_tabs}", "gap": 800},
    {"wait_for": "offline_tab", "timeout": 10},
    {"shot": "offline-tab"},
    {"seek": "sgb_selected", "press": "down", "max": 8},
    {"key": "enter"},
    {"wait_for": ["sgb_select", "sgb_locked", "stage_select", "match_hud"], "timeout": 60},
    {"shot": "sgb-entry"},
    {"note": "TODO: ghost / character / stage choices (J keeps the defaults)"},
    {"wait_for": "match_hud", "timeout": 120, "press": "j", "every": 4},
    {"phase": "play"},
    {"play_until": "sgb_post_match", "while": "match_hud", "keys": "u i j k u i j k a d w s", "every": 0.3, "timeout": "${match_timeout}"},
    {"note": "second match: the post-match menu's first item (TODO: confirm it is 'next match' / rematch)"},
    {"key": "j"},
    {"wait_for": "match_hud", "timeout": 120, "press": "j", "every": 4},
    {"play_until": "sgb_post_match", "while": "match_hud", "keys": "u i j k u i j k a d w s", "every": 0.3, "timeout": "${match_timeout}"},
    {"phase": "leave"},
    {"seek": "sgb_post_match_main_menu", "press": "s", "max": 8},
    {"key": "enter"},
    {"wait_for": "main_menu", "timeout": 60, "press": "k", "every": 6},
    {"note": "OPTIONS sits in the bottom icon row under every tab (TODO: confirm from the OFFLINE tab)"},
    {"seek": "options_selected", "press": "down", "max": 8},
    {"key": "enter"},
    {"wait_for": "options", "timeout": 15},
    {"seek": "quit_selected", "press": "down", "max": 12},
    {"key": "enter"},
    {"wait_for": "quit_confirm", "timeout": 10},
    {"seek": "quit_yes", "press": "up", "max": 3},
    {"phase": "exit"},
    {"key": "enter"},
    {"expect_exit": 60}
  ]
}
