  "steps": [
    {"phase": "boot"},
    {"wait_for": ["title", "char_select"], "timeout": 300},
    {"key": "enter", "if": "title"},
    {"wait_for": "char_select", "timeout": 60},
    {"phase": "enter"},
    {"note": "the card of the rung's character: it loads HL-0c-09 (dated 2099 in SaveGameList), the file the harness just installed"},
    {"wait_for": "${card_cp}", "timeout": 15},
    {"move": "${card_xy}"},
    {"click": "${card_xy}"},
    {"wait_for": "loading", "timeout": 90},
    {"phase": "load"},
    {"wait_gone": "loading", "timeout": 300, "for": 5},
    {"wait": "${settle_s}"},
    {"phase": "play"},
    {"shot": "spawn"},
    {"play": "${move_s}", "keys": "w a s d w shift+w w s", "every": 0.8, "hold": 700},
    {"play": "${look_s}", "keys": "look:600,0 look:-600,0 look:0,120 look:0,-120 look:1200,0", "every": 0.5, "hold": 600},
    {"play": "${cast_s}", "keys": "lmb lmb lmb space r 1 2 3 4", "every": 0.7, "hold": 120},
    {"play": "${move_s}", "keys": "shift+w shift+a shift+d w s look:500,0 look:-500,0 lmb space", "every": 0.5, "hold": 600},
    {"shot": "before-quit"},
    {"key": "esc"},
    {"wait_for": "field_guide", "timeout": 30, "press": "esc", "every": 6},
    {"phase": "leave"},
    {"click": [842, 545]},
    {"wait_for": "settings_menu", "timeout": 15},
    {"click": [392, 367]},
    {"wait_for": "quit_confirm", "timeout": 15},
    {"phase": "exit"},
    {"key": "space"},
    {"expect_exit": 150}
  ]
