  "save_slot": {"dir": "{localappdata}\\Hogwarts Legacy\\Saved\\SaveGames\\{accountid}", "file": "HL-00-09.sav"},
  "vars": {"card_cp": "card_ah", "card_xy": [240, 78], "settle_s": 10, "move_s": 60, "look_s": 20, "cast_s": 30},
  "checkpoints": {
    "title": {"image": "title.png", "region": [490, 590, 300, 34], "threshold": 0.8},
    "char_select": {"image": "char_select.png", "region": [62, 502, 356, 36], "threshold": 0.8},
    "card_ah": {"image": "card_ah.png", "region": [146, 60, 150, 20], "threshold": 0.85},
    "card_aram": {"image": "card_aram.png", "region": [146, 146, 150, 20], "threshold": 0.85},
    "card_harry": {"image": "card_harry.png", "region": [146, 232, 150, 20], "threshold": 0.85},
    "card_genz": {"image": "card_genz.png", "region": [146, 318, 150, 20], "threshold": 0.85},
    "loading": {"image": "loading.png", "region": [36, 588, 96, 26], "threshold": 0.8},
    "field_guide": {"image": "field_guide.png", "region": [1040, 686, 214, 22], "threshold": 0.8},
