{
  "game": "Stellar Blade",
  "process": "SB-Win64-Shipping",
  "source": "mopic",
  "max_width": 1280,
  "images": "StellarBlade",
  "notes": "Save ladder route (ladders\\StellarBlade.json): StellarBlade's route and checkpoint images, with the rung's save installed over StellarBladeSave00.sav (save_slot) after save_retarget wrote this PC's Steam account into a copy (the game refuses another account's save). The 불러오기 list then shows that save as its first card (one card per save file; a NG+ play-through adds StellarBladeSave01.sav and so on, which the harness does not touch: if one exists the newest card is first, check the load_list shot). Same UEVR requirement as StellarBlade (PR #28, c1ecaa87 on). A rung saved inside a fight or a cut scene may not show the HUD or reach the pause menu: MENU_FAIL (no harm).",
  "save_slot": {"dir": "{localappdata}\\SB\\Saved\\SaveGames\\{sid64}", "file": "StellarBladeSave00.sav"},
  "save_retarget": "stellarblade",
  "config": {"FrameworkConfig_RememberMenuState": "true", "FrameworkConfig_MenuOpen": "false"},
  "vars": {"play_s": 45, "look_s": 20},
  "checkpoints": {
    "title": {"image": "title.png", "region": [400, 664, 480, 18], "threshold": 0.8},
    "continue_selected": {"image": "continue_selected.png", "region": [116, 362, 146, 30], "threshold": 0.8, "mode": "highlight"},
    "load_selected": {"image": "load_selected.png", "region": [116, 433, 118, 30], "threshold": 0.8, "mode": "highlight"},
    "load_list": {"image": "load_list.png", "region": [148, 274, 100, 34], "threshold": 0.8},
    "hud": {"image": "hud.png", "region": [158, 640, 32, 36], "threshold": 0.8},
    "pause_menu": {"image": "pause_menu.png", "region": [264, 46, 98, 30], "threshold": 0.8},
    "settings_tab": {"image": "settings_tab.png", "region": [548, 46, 62, 32], "threshold": 0.8},
    "exit_selected": {"image": "exit_selected.png", "region": [130, 550, 142, 34], "threshold": 0.8, "mode": "highlight"},
    "quit_game_selected": {"image": "quit_game_selected.png", "region": [530, 192, 326, 38], "threshold": 0.8, "mode": "highlight"},
    "exit_panel": {"image": "exit_panel.png", "region": [328, 156, 146, 64], "threshold": 0.8},
    "quit_confirm": {"image": "quit_confirm.png", "region": [500, 304, 280, 74], "threshold": 0.8}
  },
  "steps": [
    {"phase": "boot"},
    {"note": "without the PlayStation PC SDK Runtime: its error box (about 30 s after the window; not at every start) stops the game's main thread until OK"},
    {"dismiss_dialog": "System Error", "timeout": 75},
    {"wait_for": "title", "timeout": 240},
    {"wait": 1},
    {"shot": "title"},
    {"phase": "load"},
    {"seek": "load_selected", "press": "down", "max": 5},
    {"key": "space"},
    {"wait_for": "load_list", "timeout": 15},
    {"wait": 1},
    {"shot": "load_list"},
    {"note": "Space loads the first card (the newest save) right away"},
    {"key": "space"},
    {"wait_for": "hud", "timeout": 180},
    {"phase": "play"},
    {"wait": 2},
    {"shot": "spawn"},
    {"play": "${play_s}", "keys": "w a s d w w", "every": 0.7, "hold": 500},
    {"play": "${look_s}", "keys": "look:600,0 look:-600,0 look:0,120 look:0,-120 look:1200,0 look:-300,0", "every": 0.5, "hold": 600},
    {"play": "${play_s}", "keys": "w w a w d s w lmb lmb", "every": 0.5, "hold": 400},
    {"shot": "played"},
    {"phase": "leave"},
    {"key": "esc"},
    {"wait_for": "pause_menu", "timeout": 15},
    {"seek": "settings_tab", "press": "e", "max": 8},
    {"note": "the settings list does not wrap: 11 presses always end on 나가기 (the 11th item)"},
    {"key": "down", "times": 11, "gap": 300},
    {"wait_for": "exit_selected", "timeout": 10},
    {"key": "space"},
    {"wait_for": "exit_panel", "timeout": 10},
    {"seek": "quit_game_selected", "press": "down", "max": 3},
    {"key": "space"},
    {"wait_for": "quit_confirm", "timeout": 10},
    {"shot": "quit_confirm"},
    {"phase": "exit"},
    {"key": "space"},
    {"expect_exit": 90}
  ]
}
