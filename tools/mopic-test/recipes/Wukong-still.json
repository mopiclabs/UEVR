{
  "game": "Black Myth: Wukong",
  "process": "b1-Win64-Shipping",
  "source": "mopic",
  "max_width": 1280,
  "notes": "Wukong-save without playing: loads the save and stands still for ${still_s} s (measured), then quits. For A/B runs that need the same picture every time (binocular brightness, rendering cvars).",
  "images": "Wukong-save",
  "config": {
    "FrameworkConfig_RememberMenuState": "true",
    "FrameworkConfig_MenuOpen": "false"
  },
  "save_slot": {
    "dir": "{gamedir}\\b1\\Saved\\SaveGames\\{sid64}",
    "file": "ArchiveSaveFile.9.sav"
  },
  "vars": {
    "play_s": 45,
    "load_wait_s": 10,
    "still_s": 75
  },
  "checkpoints": {
    "title": {
      "image": "title.png",
      "region": [
        120,
        300,
        246,
        76
      ],
      "threshold": 0.8
    },
    "main_menu": {
      "image": "main_menu.png",
      "region": [
        56,
        290,
        120,
        180
      ],
      "threshold": 0.8
    },
    "load_hover": {
      "image": "load_hover.png",
      "region": [
        48,
        366,
        250,
        26
      ],
      "threshold": 0.8,
      "mode": "highlight"
    },
    "load_list": {
      "image": "load_list.png",
      "region": [
        108,
        82,
        250,
        24
      ],
      "threshold": 0.7
    },
    "five_saves": {
      "image": "five_saves.png",
      "region": [
        164,
        107,
        13,
        18
      ],
      "threshold": 0.9
    },
    "last_save_hover": {
      "image": "last_save_hover.png",
      "region": [
        324,
        490,
        68,
        42
      ],
      "threshold": 0.8
    },
    "load_confirm": {
      "image": "load_confirm.png",
      "region": [
        455,
        320,
        370,
        30
      ],
      "threshold": 0.8
    },
    "new_round": {
      "image": "new_round.png",
      "region": [
        490,
        320,
        300,
        30
      ],
      "threshold": 0.8
    },
    "cancel_hover": {
      "image": "cancel_hover.png",
      "region": [
        650,
        410,
        250,
        26
      ],
      "threshold": 0.8,
      "mode": "highlight"
    },
    "loading": {
      "image": "loading.png",
      "region": [
        566,
        666,
        148,
        30
      ],
      "threshold": 0.8
    },
    "pause_menu": {
      "image": "pause_menu.png",
      "region": [
        38,
        20,
        102,
        26
      ],
      "threshold": 0.8
    },
    "settings_tab": {
      "image": "settings_tab.png",
      "region": [
        134,
        520,
        110,
        28
      ],
      "threshold": 0.8
    },
    "exit_panel": {
      "image": "exit_panel.png",
      "region": [
        222,
        178,
        104,
        26
      ],
      "threshold": 0.8
    },
    "quit_confirm": {
      "image": "quit_confirm.png",
      "region": [
        516,
        320,
        248,
        30
      ],
      "threshold": 0.8
    },
    "quit_confirm_unsaved": {
      "image": "quit_confirm_unsaved.png",
      "region": [
        444,
        310,
        392,
        28
      ],
      "threshold": 0.8
    },
    "loading_band": {
      "image": "loading_band.png",
      "region": [
        420,
        457,
        80,
        24
      ],
      "threshold": 0.8
    }
  },
  "steps": [
    {
      "phase": "boot"
    },
    {
      "wait_for": [
        "title",
        "main_menu"
      ],
      "timeout": 300
    },
    {
      "key": "enter",
      "if": "title"
    },
    {
      "note": "an Enter while the title is still fading in is dropped (5 of 15 ladder rungs on 2026-10-04 stayed on the title): click an empty corner until the menu shows; a click there does nothing on the menu, an Enter could pick 계속하기"
    },
    {
      "wait_for": "main_menu",
      "timeout": 60,
      "click": [
        1220,
        660
      ],
      "every": 6
    },
    {
      "phase": "load"
    },
    {
      "note": "게임 로딩 (Load Game), hovered first: the highlight shows the click will hit it"
    },
    {
      "move": [
        110,
        379
      ]
    },
    {
      "wait_for": "load_hover",
      "timeout": 15
    },
    {
      "click": [
        110,
        379
      ]
    },
    {
      "wait_for": "load_list",
      "timeout": 30
    },
    {
      "wait_for": "five_saves",
      "timeout": 10
    },
    {
      "note": "the installed save is the oldest: scroll the list to its end with the mouse over it, then the last entry sits under the mouse"
    },
    {
      "move": [
        430,
        480
      ]
    },
    {
      "key": "wheel:-10"
    },
    {
      "wait": 1.5
    },
    {
      "move": [
        430,
        480
      ]
    },
    {
      "wait_for": "last_save_hover",
      "timeout": 10
    },
    {
      "key": "e"
    },
    {
      "wait_for": "load_confirm",
      "timeout": 15
    },
    {
      "move": [
        503,
        423
      ]
    },
    {
      "click": [
        503,
        423
      ]
    },
    {
      "note": "a cleared save asks to start a new round (NG+): 취소 loads it as it is"
    },
    {
      "wait_for": [
        "new_round",
        "loading",
        "loading_band"
      ],
      "timeout": 30
    },
    {
      "move": [
        777,
        423
      ],
      "if": "new_round"
    },
    {
      "wait_for": "cancel_hover",
      "timeout": 10,
      "if": "new_round"
    },
    {
      "click": [
        777,
        423
      ],
      "if": "new_round"
    },
    {
      "wait_for": [
        "loading",
        "loading_band"
      ],
      "timeout": 60
    },
    {
      "note": "the loading screen (20-60 s) animates its bottom ornament (the icon and the swirls fade out, at times all of it for 5 s and more), so the band behind the tip title (loading_band, the same on every tip) decides; play starts when neither has shown for 5 s"
    },
    {
      "wait_gone": [
        "loading",
        "loading_band"
      ],
      "timeout": 300,
      "for": 5
    },
    {
      "wait": "${load_wait_s}"
    },
    {
      "phase": "play"
    },
    {
      "shot": "spawn"
    },
    {
      "note": "stand still where the save puts us: the same view every run, for A/B of rendering settings"
    },
    {
      "wait": "${still_s}",
      "measure": true
    },
    {
      "key": "esc"
    },
    {
      "wait_for": "pause_menu",
      "timeout": 60,
      "press": "esc",
      "every": 8
    },
    {
      "phase": "leave"
    },
    {
      "seek": "settings_tab",
      "press": "d",
      "max": 7,
      "gap": 1.5
    },
    {
      "move": [
        196,
        533
      ]
    },
    {
      "click": [
        196,
        533
      ]
    },
    {
      "wait_for": "exit_panel",
      "timeout": 15
    },
    {
      "click": [
        272,
        190
      ]
    },
    {
      "note": "the question gets a second line (unsaved progress is lost) when the game has not saved lately"
    },
    {
      "wait_for": [
        "quit_confirm",
        "quit_confirm_unsaved"
      ],
      "timeout": 15
    },
    {
      "wait": 1
    },
    {
      "phase": "exit"
    },
    {
      "click": [
        503,
        423
      ]
    },
    {
      "expect_exit": 90
    }
  ]
}