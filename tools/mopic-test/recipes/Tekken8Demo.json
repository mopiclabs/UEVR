    "quit_selected": {"image": "quit_selected.png", "region": [338, 466, 604, 28], "threshold": 0.8, "mode": "highlight"},
    "quit_confirm": {"image": "quit_confirm.png", "region": [540, 310, 200, 80], "threshold": 0.8},
    "quit_yes": {"image": "quit_yes.png", "region": [392, 364, 496, 54], "threshold": 0.8, "mode": "highlight"},
    "pvc_selected": {"image": "pvc_selected.png", "region": [142, 243, 214, 28], "threshold": 0.8, "mode": "highlight"},
    "options_selected": {"image": "options_selected.png", "region": [129, 523, 36, 36], "threshold": 0.8, "mode": "highlight"},
    "playside": {"image": "playside.png", "region": [535, 496, 172, 30], "threshold": 0.8},
    "char_select": {"image": "char_select.png", "region": [620, 416, 250, 52], "threshold": 0.75},
    "difficulty": {"image": "difficulty.png", "region": [750, 292, 380, 132], "threshold": 0.8},
    "stage_select": {"image": "stage_select.png", "region": [118, 86, 214, 66], "threshold": 0.8},
    "vs_screen": {"image": "vs_screen.png", "region": [588, 278, 112, 104], "threshold": 0.8},
    "in_match": {"image": "in_match.png", "region": [1098, 100, 86, 24], "threshold": 0.8},
