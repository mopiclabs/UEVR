  "steps": [
    {"phase": "boot"},
    {"note": "demo notice (OK), then the opening movie and logos: Enter skips them (and may also get past the title)"},
    {"wait_for": "notice", "timeout": 150},
    {"key": "enter"},
    {"wait_for": ["title", "main_menu"], "timeout": 240, "press": "enter", "every": 5},
    {"wait": 1, "if": "title"},
    {"key": "enter", "if": "title"},
    {"wait_for": "main_menu", "timeout": 60, "press": "enter", "every": 5},
    {"phase": "enter"},
    {"seek": "pvc_selected", "press": "down", "max": 6},
    {"key": "enter"},
    {"wait_for": "playside", "timeout": 30},
    {"wait": 1},
    {"key": "enter"},
    {"note": "an Enter during a screen's fade-in is dropped now and then (2 of 6 runs on 2026-10-08): presses are retried while the next screen is missing"},
    {"wait_for": "char_select", "timeout": 30, "press": "enter", "every": 6},
    {"wait": 1},
    {"note": "P1 JIN, CPU KAZUYA (the default cursors)"},
    {"key": "enter"},
    {"wait": 2},
    {"key": "enter"},
    {"wait_for": "difficulty", "timeout": 30, "press": "enter", "every": 6},
    {"keys": "up enter"},
    {"wait_for": "stage_select", "timeout": 20},
    {"key": "enter"},
    {"wait_for": "vs_screen", "timeout": 60},
    {"wait_for": "in_match", "timeout": 60},
    {"phase": "play"},
    {"note": "fight until the match is over; keys only while the HUD shows (J/K are also menu confirm/back)"},
    {"play_until": "post_match", "while": "in_match", "keys": "u i j k u i j k a d", "every": 0.3, "timeout": 600},
    {"phase": "leave"},
    {"note": "after a match the menus take P1's movement keys (W/A/S/D), not the arrows"},
    {"seek": "post_match_main_menu", "press": "s", "max": 6},
    {"key": "enter"},
    {"wait_for": "main_menu", "timeout": 60},
    {"seek": "options_selected", "press": "down", "max": 8},
    {"key": "enter"},
    {"wait_for": "options", "timeout": 15},
    {"seek": "quit_selected", "press": "down", "max": 12},
    {"key": "enter"},
    {"wait_for": "quit_confirm", "timeout": 10},
    {"seek": "quit_yes", "press": "up", "max": 3},
    {"phase": "exit"},
    {"key": "enter"},
    {"expect_exit": 60}
  ]
